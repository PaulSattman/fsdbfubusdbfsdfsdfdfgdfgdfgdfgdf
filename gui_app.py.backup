            if seleccion:
                nombre_partida = listbox.get(seleccion[0])
                dialogo.destroy()
                select_dialog.destroy()
                self.cargar_partida(nombre_partida)

        Button(select_dialog, text="Cargar",
               command=cargar_seleccionada,
               bg=self.colors['success'], fg='white',
